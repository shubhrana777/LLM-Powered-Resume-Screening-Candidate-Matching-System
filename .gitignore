# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# Packaging & build artifacts
build/
dist/
*.egg-info/
.eggs/

# Test & tooling caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.tox/

# IDE / editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Runtime state written by start_app.ps1 (pids, ports, service logs)
.run/

# Generated / temporary output
*.log
*.tmp
tmp/
output/

# Real resumes must never be committed (keep the folder, ignore its contents)
data/resumes/*
!data/resumes/.gitkeep

# Claude Code local skills
.claude/
