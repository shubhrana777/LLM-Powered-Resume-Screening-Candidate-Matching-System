# Copy this file to .env and adjust as needed.
#
# Nothing in the application reads these yet: Phase 1 and Phase 2 take every
# setting from command-line arguments, and no phase so far needs a secret or an
# API key. The file exists so the convention is in place, and so that the
# defaults below are documented in one spot.
#
# Never put real API keys in this file -- it is committed. Put them in .env,
# which is git-ignored.

# Directory scanned for resume PDFs (CLI default: data/resumes).
RESUME_DIR=data/resumes

# Sentence Transformers model used for embeddings
# (CLI default: sentence-transformers/all-MiniLM-L6-v2).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
