# Copy this file to .env and adjust as needed.
#
# Phases 1-3 read nothing from here: they take every setting from command-line
# arguments and need no credentials. Phase 4 is the first phase that can use an
# API key, and even then it is optional -- the default LLM provider is an
# offline deterministic one, so the CLI and the whole test suite run with no
# key at all.
#
# Never put a real key in this file: it is committed. Put it in .env, which is
# git-ignored.

# --- Phase 1/2 defaults (read by the Phase 5 API; CLI takes them as flags) --

# Directory scanned for resume PDFs (CLI default: data/resumes).
RESUME_DIR=data/resumes

# Sentence Transformers model used for embeddings
# (CLI default: sentence-transformers/all-MiniLM-L6-v2).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Phase 4: LLM provider (read by app/llm.py) -----------------------------

# fake      -> offline deterministic provider. No key, no network. THE DEFAULT.
# anthropic -> the real Claude API. Requires LLM_API_KEY and `pip install anthropic`.
# langchain -> only usable from code; build the chat model and pass it to
#              LangChainProvider(chat_model).
LLM_PROVIDER=fake

# Model id for the chosen provider.
LLM_MODEL=claude-opus-5

# API key. ANTHROPIC_API_KEY is also accepted. Leave blank for LLM_PROVIDER=fake.
LLM_API_KEY=

# Maximum tokens in a single model response.
LLM_MAX_TOKENS=4096

# --- Phase 5: REST API (read by app/api/config.py) --------------------------

# Browser origins allowed to call the API, comma separated. The default covers
# a local Streamlit dashboard on its usual port.
#
# "*" allows any origin. That is a DEVELOPMENT-ONLY setting: name the origins
# explicitly anywhere else.
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Largest accepted upload for POST /upload-resume, in bytes. Default 5 MB.
API_MAX_UPLOAD_BYTES=5242880

# Log level for the application's own logger. Requests, uploaded file names and
# failures are logged; resume contents, candidate details and credentials are not.
API_LOG_LEVEL=INFO

# --- Phase 6: Streamlit dashboard (read by app/ui/config.py) ----------------

# Where the dashboard looks for the FastAPI backend. Change it if the API runs
# on another host or port; the dashboard needs no filesystem access of its own.
API_BASE_URL=http://127.0.0.1:8000

# Timeout for health, listing, upload and matching requests, in seconds.
API_TIMEOUT_SECONDS=30

# Timeout for candidate analysis, which makes one language-model call. The very
# first request also loads the embedding model, so this is deliberately long.
API_ANALYSIS_TIMEOUT_SECONDS=180

# How many candidates the ranking asks for by default.
UI_DEFAULT_TOP_K=10
