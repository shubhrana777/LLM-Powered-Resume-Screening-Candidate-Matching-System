# Example configuration.
#
#   copy .env.example .env
#
# EVERY SETTING BELOW IS OPTIONAL. The project runs with no .env at all: each
# value falls back to the default shown, and no credential is needed for the
# application, the CLI or the test suite.
#
# How this file is used
# ---------------------
# The application reads its configuration from ENVIRONMENT VARIABLES, not from
# this file -- no module in app/ opens .env, and the project has no dotenv
# dependency. Two ways to make these values take effect:
#
#   1. start_app.ps1 loads .env into the environment before starting the
#      services. This is the usual route.
#   2. Set them in your shell before starting a service by hand:
#        $env:LLM_PROVIDER = "anthropic"
#
# A value already set in the shell always wins over this file.
#
# Never commit .env. It is git-ignored, and it is where a real API key would
# go. Keep this file free of real credentials: it IS committed.


# --- Where resumes live -----------------------------------------------------

# Optional. Directory the API scans for candidate PDFs. Resumes uploaded
# through the dashboard are stored here. Git-ignored: real resumes contain
# personal data and must not be committed.
# Default: data/resumes
RESUME_DIR=data/resumes


# --- Embedding model --------------------------------------------------------

# Optional. Sentence Transformers model used for semantic matching. Downloaded
# from Hugging Face on first use (~90 MB) and cached locally afterwards.
# Changing it changes every score, so scores are not comparable across models.
# Default: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# --- Language model provider ------------------------------------------------
# This is the only group that can involve a credential, and it is entirely
# optional. Left alone, candidate analysis runs offline against a deterministic
# provider that needs no key and no network.

# Optional. One of:
#   fake       Offline deterministic provider. No key, no network. THE DEFAULT.
#   anthropic  The real Claude API. Requires LLM_API_KEY and `pip install anthropic`.
#   langchain  Usable from Python only: build the chat model yourself and pass
#              it to LangChainProvider(chat_model).
# Default: fake
LLM_PROVIDER=fake

# Optional. Model id for the chosen provider. Ignored when LLM_PROVIDER=fake.
# Default: claude-opus-5
LLM_MODEL=claude-opus-5

# Optional. Required ONLY when LLM_PROVIDER=anthropic. ANTHROPIC_API_KEY is
# also accepted. Leave blank for the default offline provider.
# Never put a real key in .env.example -- put it in .env, which is git-ignored.
LLM_API_KEY=

# Optional. Maximum tokens in a single model response.
# Default: 4096
LLM_MAX_TOKENS=4096


# --- API service ------------------------------------------------------------

# Optional. Browser origins allowed to call the API, comma separated. The
# default covers the dashboard on its usual port.
# "*" allows any origin and is a DEVELOPMENT-ONLY setting.
# Default: http://localhost:8501,http://127.0.0.1:8501
API_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Optional. Largest accepted upload for POST /upload-resume, in bytes.
# Default: 5242880 (5 MB)
API_MAX_UPLOAD_BYTES=5242880

# Optional. Log level for the application's own logger. Requests, uploaded file
# names and failures are logged; resume contents and credentials are not.
# Default: INFO
API_LOG_LEVEL=INFO


# --- Dashboard --------------------------------------------------------------

# Optional. Where the dashboard looks for the API. Change it if the API runs on
# another host or port. The dashboard needs no filesystem access of its own.
# Default: http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000

# Optional. Timeout in seconds for health, listing, upload and matching calls.
# Default: 30
API_TIMEOUT_SECONDS=30

# Optional. Timeout in seconds for candidate analysis, which makes one model
# call. The first request also loads the embedding model, so this is generous.
# Default: 180
API_ANALYSIS_TIMEOUT_SECONDS=180

# Optional. How many candidates the ranking asks for by default.
# Default: 10
UI_DEFAULT_TOP_K=10
